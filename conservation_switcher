#!/usr/bin/env bash

# Find the correct VPC directory dynamically
VPC_DIR=$(find /sys/bus/platform/drivers/ideapad_acpi/ -maxdepth 1 -name 'VPC[0-9]*' -type l 2>/dev/null | head -n 1)
if [ -z "$VPC_DIR" ]; then
	echo "Error: Could not find Ideapad ACPI device." >&2
	exit 1
fi

echo "$1" | sudo tee "${VPC_DIR}/conservation_mode"
