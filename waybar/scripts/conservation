#!/usr/bin/env bash

FILE=/sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode
state=$(cat "$FILE")
CURRENT_DIR=$(realpath ${BASH_SOURCE[0]%/*})

source $CURRENT_DIR/util
WAYBAR_LAYER="custom/conservation"
LAYOUT_SIGNAL=$(get_signal $WAYBAR_LAYER)
if [[ -z $LAYOUT_SIGNAL ]]; then
	echo "No signal detected to notify $WAYBAR_LAYER" >&2
fi

if [ "$1" = "toggle" ]; then
	if [ "$state" -eq 1 ]; then
		echo 0 | sudo tee "$FILE" > /dev/null
	else
		echo 1 | sudo tee "$FILE" > /dev/null
	fi
	pkill -RTMIN+$LAYOUT_SIGNAL waybar

	exit 0
fi

# Output for Waybar
state=$(cat "$FILE")
if [ "$state" -eq 1 ]; then
	echo -e "{\"class\": \"conserv_on\", \"alt\":\"conserv_on\", \"text\": \"Conservation ON\"}"
else
	echo -e "{\"class\": \"conserv_off\", \"alt\":\"conserv_off\", \"text\": \"Conservation OFF\"}"
fi
