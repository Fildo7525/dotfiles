#!/usr/bin/env bash

help() {
	echo "switchlayout next|prev"
}

reverse_assoc() {
	local -n src="$1"
	local -n dst="$2"

	for key in "${!src[@]}"; do
		dst["${src[$key]}"]="$key"
	done
}

motion=1
case $1 in
	next)
		motion=1
		;;
	prev)
		motion=-1
		;;
	*)
		help 1>&2
		exit 1
		;;
esac

source $HOME/.config/waybar/scripts/util
WAYBAR_LAYER="custom/layout"
LAYOUT_SIGNAL=$(get_signal $WAYBAR_LAYER)
if [[ -z $LAYOUT_SIGNAL ]]; then
	echo "No signal detected to notify $WAYBAR_LAYER" >&2
fi

layout=$(hyprctl getoption general:layout | grep "str" | awk '{print $2}')
declare -A layouts
layouts["dwindle"]=0
layouts["master"]=1
layouts["monocle"]=2
layouts["lua:grid"]=3

declare -A layouts_reversed
reverse_assoc layouts layouts_reversed

if [[ ! -n ${layouts[$layout]:-} ]]; then
	hyprctl eval "hl.config({ general = { layout = \"dwindle\"}})"
	[[ -z $LAYOUT_SIGNAL ]] || pkill -RTMIN+$LAYOUT_SIGNAL waybar
	exit 0
fi

l_num=${layouts["$layout"]:-}
l_num=$(((l_num + motion + 4) % 4))

# notify-send "L_NUM" "$l_num"

new_layout=${layouts_reversed[$l_num]}

# notify-send "new_layout" "$new_layout"
hyprctl eval "hl.config({ general = { layout = \"$new_layout\"}})"
[[ -z $LAYOUT_SIGNAL ]] || pkill -RTMIN+$LAYOUT_SIGNAL waybar

